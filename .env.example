# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# ---- Django ----
# คีย์ลับ ยาวอย่างน้อย 50 ตัว สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# โฮสต์ที่อนุญาต คั่นด้วย comma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# เปิด /django-admin/ สำหรับนักพัฒนา (production ควรเป็น False)
DJANGO_ADMIN_ENABLED=True

# ---- แบรนด์ ----
# ชื่อร้านที่แสดงบนเว็บ
SITE_NAME=TMPP
# URL หลักของเว็บ (production: https://tmth-th.com)
SITE_URL=http://localhost:8000

# ---- PostgreSQL + PostGIS (docker-compose.yml ใช้ 3 ค่านี้สร้างฐานข้อมูล) ----
POSTGRES_DB=tmpp
POSTGRES_USER=tmpp
# รหัสผ่านฐานข้อมูล ตั้งใหม่ทุกเครื่อง
POSTGRES_PASSWORD=change-me
# Django ต่อฐานข้อมูลผ่าน URL นี้ (พอร์ต 5433 เพื่อไม่ชนกับฐานข้อมูลของระบบเดิมที่ 5432)
DATABASE_URL=postgis://tmpp:change-me@127.0.0.1:5433/tmpp

# ---- Redis (พอร์ต 6380 ตาม docker-compose.yml) ----
# ใช้ทั้ง cache และ Celery broker · ปล่อยว่างถ้าเครื่องไม่มี Redis (ใช้ cache ในหน่วยความจำแทน เฉพาะตอนพัฒนา)
REDIS_URL=redis://127.0.0.1:6380/0

# ---- GDAL บน Mac (ใส่เฉพาะเมื่อ manage.py check แจ้งว่าหา GDAL ไม่เจอ) ----
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# ---- ฐานข้อมูลทดสอบ (pytest) ----
# ถ้ารัน PostgreSQL บนเครื่องโดยไม่ใช้ Docker: ชื่อ template ที่ลง PostGIS ไว้แล้ว (ว่าง = ไม่ใช้)
DB_TEST_TEMPLATE=

# ---- Google Sign-In ----
# OAuth Client ID (ประเภท Web) จาก Google Cloud Console · ว่าง = ไม่แสดงปุ่มล็อกอินด้วย Google
GOOGLE_CLIENT_ID=

# ---- บัญชีทดสอบ (เครื่องพัฒนาเท่านั้น) ----
# รหัสผ่านของบัญชี *@tmpp.test ที่สร้างด้วย python manage.py seed_dev_users (อย่างน้อย 12 ตัว)
DEV_SEED_PASSWORD=

# ---- ค่าส่ง (ถ้าไม่ใส่ใช้ค่าตามนี้) ----
# ค่าส่งเริ่มต้น (บาท) สำหรับระยะแรก
DELIVERY_BASE_FARE=30
# ระยะแรกกี่กม.
DELIVERY_BASE_DISTANCE_KM=3
# เกินระยะแรก คิดกม.ละ (บาท)
DELIVERY_PER_KM_FARE=6
# ไรเดอร์ได้ต่อเที่ยว (บาท) และต่อกม.ที่เกิน
RIDER_BASE_EARNING=25
RIDER_PER_KM_EARNING=5
# ส่งไกลสุด (กม.) เกินนี้สั่งไม่ได้
MAX_DELIVERY_DISTANCE_KM=15

# ---- Google Maps ----
# Maps JavaScript API key จำกัด HTTP referrer เป็นโดเมนเรา · ว่าง = ไม่แสดงแผนที่ปักหมุด
GOOGLE_MAPS_API_KEY=

# ---- ชำระเงิน ----
# พร้อมเพย์รับเงิน: เบอร์ 10 หลัก / เลขบัตร 13 หลัก / e-Wallet 15 หลัก (ว่าง = สร้าง QR ไม่ได้)
PROMPTPAY_ID=
# เลขบัญชีธนาคารที่ผูกพร้อมเพย์ + รหัสธนาคาร (ใช้เทียบเลขบัญชีผู้รับในสลิป)
SHOP_BANK_ACCOUNT=
SHOP_BANK_CODE=
# ชื่อบัญชีผู้รับตามที่ขึ้นในสลิป ไทยและอังกฤษ คั่นด้วย comma
SHOP_ACCOUNT_NAMES=
# EasySlip API key (ว่าง = ส่งสลิปทุกใบให้เจ้าของตรวจเอง)
EASYSLIP_API_KEY=
# AUTO = ตรวจอัตโนมัติ ล่มแล้วส่งให้เจ้าของ · MANUAL = เจ้าของตรวจทุกใบ
PAYMENT_VERIFICATION_MODE=AUTO
# แนบสลิปได้กี่ครั้งต่อออเดอร์
SLIP_MAX_ATTEMPTS=3
# ไม่จ่ายภายในกี่นาที ยกเลิกอัตโนมัติ
PAYMENT_WINDOW_MINUTES=20

# ---- แจ้งเตือน Firebase (FCM) ----
# path ไฟล์ service account JSON (ลับ เก็บนอกโฟลเดอร์โปรเจกต์) · ว่าง = ไม่ส่ง push แต่ยังเห็นแจ้งเตือนในเว็บ
FIREBASE_CREDENTIALS_PATH=
# ค่าฝั่งเว็บจาก Firebase Console > Project settings > General > Your apps (Web)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Firebase Console > Project settings > Cloud Messaging > Web Push certificates (Key pair)
FIREBASE_VAPID_KEY=
