# SITE_ADDRESS มาจาก .env
#   ":80"                          = ยังไม่มีโดเมน เปิดด้วย IP ผ่าน HTTP
#   "tmth-th.com, www.tmth-th.com" = Caddy ขอใบรับรอง Let's Encrypt และ redirect HTTP -> HTTPS ให้เอง
{$SITE_ADDRESS} {
	encode zstd gzip

	# รูปเมนู/รูปร้าน (สาธารณะ) · สลิปและรูปส่งของไม่อยู่ที่นี่ (ส่งผ่าน Django ที่ตรวจสิทธิ์)
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# ไฟล์ static มี hash ในชื่อ cache ได้นาน
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		request_body {
			max_size 10MB
		}
		reverse_proxy web:8000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
	}
}
