# SITE_ADDRESS มาจาก .env
#   ":80"                          = รับ HTTP (เปิดด้วย IP หรือมี Caddy ตัวอื่นทำ HTTPS อยู่ข้างหน้า)
#   "tmth-th.com, www.tmth-th.com" = Caddy ตัวนี้ขอใบรับรอง Let's Encrypt และ redirect HTTP -> HTTPS เอง
{
	servers {
		# เชื่อ X-Forwarded-Proto / X-Forwarded-For จาก proxy ข้างหน้าเฉพาะ IP ที่ไว้ใจ
		# (ช่วงใช้คู่ระบบเดิม: Caddy ของระบบเดิมทำ HTTPS แล้วส่งต่อมาที่นี่)
		# ค่าเริ่มต้น private_ranges = IP ภายใน docker/เครือข่ายส่วนตัว · คนจากอินเทอร์เน็ตปลอม header ไม่ได้
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# รูปเมนู/รูปร้าน (สาธารณะ) · สลิปและรูปส่งของไม่อยู่ที่นี่ (ส่งผ่าน Django ที่ตรวจสิทธิ์)
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# ไฟล์ static มี hash ในชื่อ cache ได้นาน
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		request_body {
			max_size 10MB
		}
		reverse_proxy web:8000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
	}
}
