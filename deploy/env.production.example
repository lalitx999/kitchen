# คัดลอกเป็น ~/kitchen/.env บน server แล้วแก้ค่า (ห้าม commit)
#   cp deploy/env.production.example .env && nano .env

# ---- Django ----
# สร้างใหม่: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# ขั้นที่ 1 ยังไม่มีโดเมน: ใส่ IP ของ server · ขั้นที่ 2: tmth-th.com,www.tmth-th.com
DJANGO_ALLOWED_HOSTS=YOUR_SERVER_IP
# ขั้นที่ 1: http://YOUR_SERVER_IP (ถ้าใช้พอร์ตอื่นใส่ :8080 ต่อท้าย) · ขั้นที่ 2: https://tmth-th.com,https://www.tmth-th.com
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP
# ขั้นที่ 1 = False (ยังเป็น HTTP) · ขั้นที่ 2 = True
HTTPS_ENABLED=False
# Django Admin ของนักพัฒนา (ปิดไว้บน server)
DJANGO_ADMIN_ENABLED=False

# ---- แบรนด์ ----
SITE_NAME=TMPP
# ขั้นที่ 1: http://YOUR_SERVER_IP · ขั้นที่ 2: https://tmth-th.com (ใช้ทำลิงก์ในแจ้งเตือน)
SITE_URL=http://YOUR_SERVER_IP

# ---- Caddy ----
# ขั้นที่ 1 = :80 · ขั้นที่ 2 = tmth-th.com, www.tmth-th.com
SITE_ADDRESS=:80
# proxy ข้างหน้าที่ไว้ใจ (ช่วงใช้คู่ระบบเดิม: private_ranges + IP สาธารณะของ server)
TRUSTED_PROXIES=private_ranges
# ถ้าพอร์ต 80/443 มีโปรแกรมอื่นใช้อยู่ (เช่นระบบเดิม) เปลี่ยนเป็น 8080/8443 ชั่วคราว
HTTP_PORT=80
HTTPS_PORT=443

# ---- ฐานข้อมูล (สร้างใหม่ใน docker ไม่ได้เปิดออกภายนอก) ----
POSTGRES_DB=tmpp
POSTGRES_USER=tmpp
# รหัสผ่านยาวๆ: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# ---- Google Sign-In (ว่าง = ซ่อนปุ่ม Google) ----
GOOGLE_CLIENT_ID=

# ---- Google Maps (ว่าง = ไม่แสดงแผนที่ปักหมุด ใช้ GPS อย่างเดียว) ----
GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud > Google Maps Platform > Map Management) · ว่าง = ใช้ DEMO_MAP_ID สำหรับทดสอบ
GOOGLE_MAPS_MAP_ID=

# ---- ค่าส่ง ----
DELIVERY_BASE_FARE=30
DELIVERY_BASE_DISTANCE_KM=3
DELIVERY_PER_KM_FARE=6
RIDER_BASE_EARNING=25
RIDER_PER_KM_EARNING=5
MAX_DELIVERY_DISTANCE_KM=15

# ---- ชำระเงิน ----
PROMPTPAY_ID=
SHOP_BANK_ACCOUNT=
SHOP_BANK_CODE=
# ชื่อบัญชีผู้รับ ไทย,อังกฤษ
SHOP_ACCOUNT_NAMES=
EASYSLIP_API_KEY=
PAYMENT_VERIFICATION_MODE=AUTO
SLIP_MAX_ATTEMPTS=3
PAYMENT_WINDOW_MINUTES=20

# ---- Firebase ----
# วางไฟล์ service account ที่ ~/kitchen/secrets/firebase-service-account.json บน server
# แล้วใส่ path "ในคอนเทนเนอร์" ตามบรรทัดล่าง (ว่าง = ไม่ส่ง push แต่ยังเห็นแจ้งเตือนในเว็บ)
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
